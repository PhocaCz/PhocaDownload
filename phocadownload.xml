<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade" version="7.0">
	<name>com_phocadownload</name>
	<author>Jan Pavelka (www.phoca.cz)</author>
	<creationDate>24/11/2026</creationDate>
	<authorEmail></authorEmail>
	<authorUrl>https://www.phoca.cz</authorUrl>
	<copyright>Jan Pavelka</copyright>
	<license>GNU/GPL</license>
	<version>7.0.0Alpha2</version>
	<description>COM_PHOCADOWNLOAD_XML_DESCRIPTION</description>
	<namespace path="src">Phoca\Component\Phocadownload</namespace>
	<scriptfile>script.php</scriptfile>
	<projectName>PhocaDownload</projectName>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">install/sql/mysql/install.utf8.sql</file>
		</sql>
	</install>

	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">install/sql/mysql/uninstall.utf8.sql</file>
		</sql>
	</uninstall>

	<update>
		<schemas>
			<schemapath type="mysql">update/sql/mysql</schemapath>
		</schemas>
	</update>

	<files folder="site">
		<folder>tmpl</folder>
		<folder>src</folder>
		<folder>layouts</folder>
		<filename>index.html</filename>
	</files>

	<media destination="com_phocadownload" folder="media">
		<folder>duotone</folder>
		<folder>css</folder>
		<folder>js</folder>
		<folder>images</folder>
		<filename>index.html</filename>
	</media>

	<languages folder="admin/language">
		<language tag="en-GB" client="site">en-GB/en-GB.com_phocadownload.ini</language>
		<language tag="en-GB" client="site">en-GB/en-GB.com_phocadownload.sys.ini</language>
	</languages>

	<administration>

		<menu img="media/com_phocadownload/images/administrator/icon-16-pdl-menu.png" alt="COM_PHOCADOWNLOAD" link="option=com_phocadownload">COM_PHOCADOWNLOAD</menu>

			<submenu>
				<menu img="media/com_phocadownload/images/administrator/icon-16-pdl-control-panel.png" alt="COM_PHOCADOWNLOAD_CONTROLPANEL" view="cp" link="option=com_phocadownload">COM_PHOCADOWNLOAD_CONTROLPANEL</menu>
				<menu img="media/com_phocadownload/images/administrator/icon-16-pdl-menu-files.png" alt="COM_PHOCADOWNLOAD_FILES" view="files" link="option=com_phocadownload&amp;view=files">COM_PHOCADOWNLOAD_FILES</menu>
				<menu img="media/com_phocadownload/images/administrator/icon-16-pdl-menu-category.png" alt="COM_PHOCADOWNLOAD_CATEGORIES" view="cats" link="option=com_phocadownload&amp;view=cats">COM_PHOCADOWNLOAD_CATEGORIES</menu>
				<menu img="media/com_phocadownload/images/administrator/icon-16-pdl-menu-lic.png" alt="COM_PHOCADOWNLOAD_LICENSES" view="lics" link="option=com_phocadownload&amp;view=lics">COM_PHOCADOWNLOAD_LICENSES</menu>
				<menu img="media/com_phocadownload/images/administrator/icon-16-pdl-menu-stat.png" alt="COM_PHOCADOWNLOAD_STATISTICS" view="stat" link="option=com_phocadownload&amp;view=stat">COM_PHOCADOWNLOAD_STATISTICS</menu>
				<menu img="media/com_phocadownload/images/administrator/icon-16-pdl-menu-downloads.png" alt="COM_PHOCADOWNLOAD_DOWNLOADS" view="downloads" link="option=com_phocadownload&amp;view=downloads">COM_PHOCADOWNLOAD_DOWNLOADS</menu>
				<menu img="media/com_phocadownload/images/administrator/icon-16-pdl-menu-uploads.png" alt="COM_PHOCADOWNLOAD_UPLOADS" view="uploads" link="option=com_phocadownload&amp;view=uploads">COM_PHOCADOWNLOAD_UPLOADS</menu>
				<menu img="media/com_phocadownload/images/administrator/icon-16-pdl-menu-vote-file.png" alt="COM_PHOCADOWNLOAD_FILE_RATING" view="rafile" link="option=com_phocadownload&amp;view=rafile">COM_PHOCADOWNLOAD_FILE_RATING</menu>
				<menu img="media/com_phocadownload/images/administrator/icon-16-pdl-menu-tags.png" alt="COM_PHOCADOWNLOAD_TAGS" view="tags" link="option=com_phocadownload&amp;view=tags">COM_PHOCADOWNLOAD_TAGS</menu>
				<menu img="media/com_phocadownload/images/administrator/icon-16-pdl-menu-style.png" alt="COM_PHOCADOWNLOAD_STYLES" view="styles" link="option=com_phocadownload&amp;view=styles">COM_PHOCADOWNLOAD_STYLES</menu>
				<menu img="media/com_phocadownload/images/administrator/icon-16-pdl-menu-logs.png" alt="COM_PHOCADOWNLOAD_LOGGING" view="logs" link="option=com_phocadownload&amp;view=logs">COM_PHOCADOWNLOAD_LOGGING</menu>
				<menu img="media/com_phocadownload/images/administrator/icon-16-pdl-menu-info.png" alt="COM_PHOCADOWNLOAD_INFO" view="info" link="option=com_phocadownload&amp;view=info">COM_PHOCADOWNLOAD_INFO</menu>
			</submenu>

		<files folder="admin">
			<folder>install</folder>
			<folder>update</folder>
			<folder>forms</folder>
			<folder>tmpl</folder>
			<folder>src</folder>
			<folder>help</folder>
			<folder>layouts</folder>
			<folder>services</folder>
			<filename>FOSS.md</filename>
			<filename>index.html</filename>
			<filename>LICENSE</filename>
			<filename>config.xml</filename>
			<filename>access.xml</filename>
		</files>

		<languages folder="admin/language">
			<language tag="en-GB">en-GB/en-GB.com_phocadownload.ini</language>
			<language tag="en-GB">en-GB/en-GB.com_phocadownload.sys.ini</language>
		</languages>
	</administration>
	
	
	<changelogurl>https://raw.githubusercontent.com/PhocaCz/PhocaDownload/master/changelog7.xml</changelogurl>

	<updateservers>
		<server type="extension" name="COM_PHOCADOWNLOAD" priority="1"><![CDATA[https://raw.githubusercontent.com/PhocaCz/PhocaDownload/master/manifest.xml]]></server>
	</updateservers>
</extension>
